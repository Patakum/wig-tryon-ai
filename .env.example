# PostgreSQL connection string. Use a disposable development database locally.
DATABASE_URL=

# Better Auth server configuration.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google sign-in. Both values are required to enable the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Client-side Better Auth URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI image generation.
OPENAI_API_KEY=

# Hair segmentation (required for generation). Model format: owner/model:version-hash,
# e.g. schananas/grounded_sam:ee871c19efb1941f55f66a3d7d960428c8a5afcb77449547fe8e5a3ab9ebc21c
REPLICATE_API_TOKEN=
REPLICATE_HAIR_SEGMENTATION_MODEL=
# Optional: index of the white-on-black hair mask in the model's output array (default 0).
REPLICATE_HAIR_MASK_OUTPUT_INDEX=
# Optional: JSON merged into the model input (default targets grounded_sam: mask_prompt "hair").
REPLICATE_HAIR_SEGMENTATION_INPUT=

# Optional customer contact and allowed remote image hosts.
WHATSAPP_PHONE=
NEXT_PUBLIC_ALLOWED_IMAGE_HOSTS=
