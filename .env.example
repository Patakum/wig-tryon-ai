# PostgreSQL connection string. Use a disposable development database locally.
DATABASE_URL=

# Better Auth server configuration.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google sign-in. Both values are required to enable the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Client-side Better Auth URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI image generation.
OPENAI_API_KEY=

# Optional: successful generations per signed-in user per 24 hours (default 3).
GENERATION_DAILY_LIMIT=

# Optional AI hair segmentation. If the model is configured, a Replicate token is required.
REPLICATE_API_TOKEN=
REPLICATE_HAIR_SEGMENTATION_MODEL=

# Optional customer contact and allowed remote image hosts.
WHATSAPP_PHONE=
NEXT_PUBLIC_ALLOWED_IMAGE_HOSTS=

# Secret that protects /api/cron/cleanup (the daily retention job). Vercel Cron
# sends it automatically as a bearer token when this variable is set.
CRON_SECRET=
